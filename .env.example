# Local2Farm Environment Configuration
# Set secret key for Flask sessions
SECRET_KEY=local2farm-secret-key-btech-2026

# AI Agent Configuration
# Set DEMO_MODE=True to run with deterministic intelligent rule-based AI reasoning
# Set DEMO_MODE=False and provide LLM_API_KEY if you want to use an external LLM
DEMO_MODE=True

# Optional LLM API Configuration (OpenAI / Gemini / Groq / etc.)
# If left empty, the application will seamlessly run in DEMO MODE with zero errors!
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
